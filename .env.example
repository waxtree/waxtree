# Discogs API token — ottieni da https://www.discogs.com/settings/developers
VITE_DISCOGS_TOKEN=your_token_here

# YouTube Data API v3 (opzionale — senza, i link aprono YouTube search)
# Ottieni da https://console.cloud.google.com/
VITE_YOUTUBE_API_KEY=

# Admin backend (admin.html + api/admin-*.js) — SOLO server-side, mai nel
# client. Impostare in Vercel → Settings → Environment Variables, scope
# "Production" soltanto (il repo è pubblico: le preview deployment da PR
# di fork vedrebbero questi valori se scope fosse "All Environments").
# Service role key: Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
# Elenco separato da virgole degli user id (auth.users.id, non email)
# autorizzati ad accedere all'admin. Vuoto = nessuno autorizzato (fail closed).
ADMIN_USER_IDS=
