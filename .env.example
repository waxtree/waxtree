# Public Supabase client config (publishable values only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only API credentials. Configure these in the deployment platform;
# never expose them through VITE_* variables or commit real values here.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# Optional: comma-separated personal Discogs access tokens (each generated
# by whoever owns that token at discogs.com/settings/developers), pooled
# and picked at random to spread search traffic across independent Discogs
# rate-limit quotas instead of the one shared consumer-key quota above.
# Leave empty to use only the consumer key/secret.
DISCOGS_TOKEN_POOL=
YOUTUBE_API_KEY=
COSINE_API_KEY=

# Server-only admin and account-deletion configuration.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_IDS=
